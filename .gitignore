!.vscode/extensions.json
!.vscode/mcp.json
.idea/
*.swp
*.swo

# Workflow temporary artifacts
.pipeline/
scratch/

# nested repositories: every top-level directory is a separately cloned Git
# repository that belongs to the multi-repo workspace, not to this
# workspace-root repo
/*/
!/.github/
!/.vscode/
!/docs/
