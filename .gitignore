node_modules/
.pnp/
.pnp.js

# Build Outputs
dist/
build/
coverage/

# Environment variables
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS metadata
.DS_Store
Thumbs.db

# IDEs
.vscode/*
!.vscode/settings.json
